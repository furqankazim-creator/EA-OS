# Provider: groq (Whisper transcription + GPT-OSS extraction) or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3
# GEMINI_API_KEY=
PORT=3001
# Auth: long random string; same value in mobile/.env as EXPO_PUBLIC_API_TOKEN. Empty = open (LAN dev only)
EA_OS_API_TOKEN=
# Approve-then-send email via SMTP (Gmail: smtp.gmail.com, 587, address, App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INVESTOR_LIST_EMAIL=investors@list.com
DATA_DIR=./data
